{
  "projects": {
    "meu-app": {
      "architect": {
        "build": {
          "options": {
            "outputPath": "dist/meu-app",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/assets/images/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "node_modules/@po-ui/style/css/po-theme-core.min.css",
              "src/styles.css"
            ],
            "polyfills": [
              "zone.js"
            ]
          },
          "builder": "@angular-devkit/build-angular:application"
        }
      }
    }
  }
}
