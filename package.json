{
  "name": "poui-project-creator",
  "displayName": "PO UI Project Creator",
  "description": "Cria e configura um novo projeto Angular com PO UI e Protheus.",
  "version": "0.0.19",
  "icon": "images/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/LukeChagastec/poui-project-creator.git"
  },
  "bugs": {
    "url": "https://github.com/LukeChagastec/poui-project-creator/issues"
  },
  "galleryBanner": {
    "color": "#2c2c32",
    "theme": "dark"
  },
  "publisher": "Chagastec",
  "license": "MIT",
  "keywords": [
    "PO UI",
    "Protheus",
    "TOTVS",
    "Angular",
    "scaffolding",
    "generator",
    "boilerplate",
    "templates"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:poui-project-creator.createProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "poui-project-creator.createProject",
        "title": "PO UI: Criar Novo Projeto Protheus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src e2e",
    "test": "node node_modules/@vscode/test-cli/out/bin.mjs",
    "test:unit": "c8 mocha 'out/test/unit/**/*.test.js'",
    "test:regression": "mocha 'out/test/regression/**/*.test.js'",
    "test:e2e": "playwright test",
    "test:all": "npm run compile && npm run test:unit && npm test && npm run test:regression && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.1.0",
    "c8": "^12.0.0",
    "eslint": "^8.39.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "glob": "^11.0.3",
    "mocha": "^11.7.2",
    "typescript": "^5.0.4"
  }
}
